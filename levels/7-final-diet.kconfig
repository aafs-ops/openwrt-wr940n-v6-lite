# Level 7 (kernel part): traffic-shaping framework (no QoS used), TCP algorithm extras (cubic stays),
# JFFS2 summary (only speeds up mounting), GPIO sysfs (unused on this board), heartbeat LED trigger
# (unused), small CRC tables.
# CONFIG_NET_SCHED is not set
# CONFIG_TCP_CONG_ADVANCED is not set
# CONFIG_JFFS2_SUMMARY is not set
# CONFIG_GPIO_SYSFS is not set
# CONFIG_LEDS_TRIGGER_HEARTBEAT is not set
# CONFIG_CRC32_SLICEBY8 is not set
CONFIG_CRC32_SARWATE=y
